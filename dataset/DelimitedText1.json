{
	"name": "DelimitedText1",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureBlobStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"feedbacksrc": {
				"type": "string",
				"defaultValue": "sample_feedback.csv"
			},
			"aibiincfeedipcontainer": {
				"type": "string",
				"defaultValue": "input"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().feedbacksrc",
					"type": "Expression"
				},
				"container": {
					"value": "@dataset().aibiincfeedipcontainer",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "id",
				"type": "String"
			},
			{
				"name": "home",
				"type": "String"
			},
			{
				"name": "category",
				"type": "String"
			},
			{
				"name": "Feedback Theme",
				"type": "String"
			},
			{
				"name": "sub_category",
				"type": "String"
			},
			{
				"name": "text",
				"type": "String"
			},
			{
				"name": "Risk rating",
				"type": "String"
			},
			{
				"name": "Date",
				"type": "String"
			},
			{
				"name": "Start of Week",
				"type": "String"
			}
		]
	}
}